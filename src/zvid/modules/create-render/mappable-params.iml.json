            { "name": "height", "type": "uinteger", "label": "Height" },
            { "name": "outputFormat", "type": "text", "label": "Output Format" },
            { "name": "frameRate", "type": "number", "label": "Frame Rate" },
            { "name": "backgroundColor", "type": "text", "label": "Background Color" },
            { "name": "snapshotTime", "type": "number", "label": "Snapshot Time (Images)" },
            { "name": "quality", "type": "number", "label": "Quality (Images)" },
            { "name": "transparent", "type": "boolean", "label": "Transparent (Images)" }
        ]
    },
