{
    "url": "/api/templates",
    "method": "GET",
    "qs": {
        "limit": 100
    },
    "response": {
        "iterate": "{{body.templates}}",
        "output": "{{item}}",
        "limit": "{{parameters.limit}}"
    },
    "pagination": {
        "qs": {
            "page": "{{pagination.page}}"
        },
        "condition": "{{body.pagination.page < body.pagination.totalPages}}"
    }
}
