{
    "url": "/api/templates/{{parameters.templateId}}",
    "method": "PUT",
    "body": {
        "name": "{{ifempty(parameters.name, undefined)}}",
        "description": "{{ifempty(parameters.description, undefined)}}",
        "payload": "{{ifempty(parameters.projectJson, undefined)}}"
    },
    "response": {
        "output": {
            "id": "{{body.template.id}}",
            "userId": "{{body.template.userId}}",
            "name": "{{body.template.name}}",
            "description": "{{body.template.description}}",
            "project": "{{body.template.project}}",
            "type": "{{body.template.type}}",
            "variablesSummary": "{{body.template.variablesSummary}}",
            "version": "{{body.template.version}}",
            "status": "{{body.template.status}}",
            "createdAt": "{{body.template.createdAt}}",
            "updatedAt": "{{body.template.updatedAt}}"
        }
    }
}
