{
    "url": "/api/webhooks",
    "method": "POST",
    "body": {
        "url": "{{webhook.url}}",
        "events": ["render.completed", "render.failed"],
        "description": "Make.com Zvid app"
    },
    "response": {
        "data": {
            "externalHookId": "{{body.webhook.id}}",
            "secret": "{{body.webhook.secret}}"
        }
    }
}
